# MiniMax Token Plan Key（订阅管理 > Token Plan）
# https://platform.minimaxi.com/user-center/payment/token-plan
MINIMAX_API_KEY=

# API 主机（国内）
MINIMAX_API_HOST=https://api.minimaxi.com

# 猜画：优先图片理解 VLM，失败再用文本模型
MINIMAX_BASE_URL=https://api.minimaxi.com/anthropic
MINIMAX_MODEL=MiniMax-M2.7

# 语音朗读 — 同步 TTS
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_VOICE_ZH=female-shaonv
MINIMAX_VOICE_EN=English_Graceful_Lady

# 站点 URL（SEO：canonical、Open Graph、sitemap，不要末尾斜杠冲突）
# 例：https://huaban.vercel.app 或 https://your-domain.com
VITE_SITE_URL=https://huaban.vercel.app
