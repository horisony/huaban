# ─────────────────────────────────────────────
# OpenAI Realtime（GPT Live 互动老师）
# 老师负责：看图、猜画、语音对话、画画指导，全部由 GPT Live 接管
# ─────────────────────────────────────────────

# OpenAI API Key
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 实时语音模型（支持图片输入，能看到孩子的画）
OPENAI_REALTIME_MODEL=gpt-realtime-2.1

# 老师的声音（alloy / coral / sage / ash / ballad 等）
OPENAI_REALTIME_VOICE=alloy

# 语音触发的图片生成模型
OPENAI_IMAGE_MODEL=gpt-image-2

# 可选：无法直连 OpenAI 时使用 Commonstack 生图
# AI_IMAGE_PROVIDER=commonstack
# COMMONSTACK_API_KEY=
# COMMONSTACK_API_BASE=https://api.commonstack.ai
# COMMONSTACK_IMAGE_MODEL=google/gemini-2.5-flash-image

# 自定义 API 入口（一般无需修改）
# OPENAI_REALTIME_API_BASE=https://api.openai.com

# ─────────────────────────────────────────────
# 站点 URL（SEO：canonical、Open Graph、sitemap，不要末尾斜杠冲突）
# 例：https://huaban.vercel.app 或 https://your-domain.com
# ─────────────────────────────────────────────
VITE_SITE_URL=https://huaban.vercel.app
